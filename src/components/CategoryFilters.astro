---
import path from 'path';
import { slugify } from '../utils/slug';
import { germanCategory, germanTag } from '../utils/tags';

interface Props {
  categorySlug: string;
  categoryName: string;
  tags: string[];
  active: string | 'all';
}

const { categorySlug, categoryName, tags, active } = Astro.props;
const { BASE_URL } = import.meta.env;
const chipClass =
  'category-chip rounded-full border border-rule px-3 py-1 text-sm font-light tracking-wide text-muted transition-colors duration-300 hover:text-ink';
const categoryUrl = path.join(BASE_URL, 'category', categorySlug);
---

<nav
  id="category-filters"
  class="mb-12 flex flex-wrap gap-2"
  aria-label="Filter by tag"
  data-en-label="Filter by tag"
  data-de-label="Nach Stichwort filtern"
>
  <a
    href={categoryUrl}
    class:list={[chipClass, { 'is-active': active === 'all' }]}
    aria-current={active === 'all' ? 'page' : undefined}
  >
    <span data-en={`All ${categoryName}`} data-de={`Alle ${germanCategory(categoryName)}`}>
      All {categoryName}
    </span>
  </a>
  {
    tags.map((tag) => {
      const slug = slugify(tag);
      return (
        <a
          href={path.join(categoryUrl, slug)}
          class:list={[chipClass, { 'is-active': active === slug }]}
          aria-current={active === slug ? 'page' : undefined}
          data-en={tag}
          data-de={germanTag(tag)}
        >
          {tag}
        </a>
      );
    })
  }
</nav>

<style>
  .category-chip.is-active {
    background-color: var(--color-accent-soft);
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
</style>
