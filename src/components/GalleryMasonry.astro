---
import { Image } from 'astro:assets';
import path from 'path';
import {
  formatMainCategoryAndTags,
  germanMainCategoryAndTags,
} from '../utils/tags';

interface ImageItem {
  id: string;
  src: string;
  mediaType?: 'image' | 'video';
  poster?: string;
  alt: string;
  title: string;
  mainCategory: string;
  tags?: string[];
  translations?: {
    de?: { title: string; alt: string; description: string };
  };
}

interface Props {
  images: ImageItem[];
  randomize?: boolean;
}

const { images, randomize = false } = Astro.props;
const { BASE_URL } = import.meta.env;
---

<div
  class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4"
  data-randomize={randomize ? 'true' : undefined}
>
  {
    images.map((image, index) => (
      <div class="min-w-0">
        <a
          href={path.join(BASE_URL, 'image', image.id)}
          class="group block overflow-hidden rounded-lg relative transition-shadow duration-300 hover:-translate-y-0.5 hover:shadow-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-500"
          transition:name={`image-${image.id}`}
        >
          <div class="overflow-hidden relative">
            {
              image.mediaType === 'video' ? (
                <div class="relative">
                  <img
                    src={image.poster}
                    alt={image.alt}
                    data-en-alt={image.alt}
                    data-de-alt={image.translations?.de?.alt ?? image.alt}
                    class="w-full h-auto object-cover"
                    loading={index < 6 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                  <span
                    class="absolute inset-0 flex items-center justify-center"
                    aria-hidden="true"
                  >
                    <span class="flex size-12 items-center justify-center rounded-full bg-black/60 text-white">
                      ▶
                    </span>
                  </span>
                </div>
              ) : image.src.startsWith('/') ? (
                <img
                  src={image.src}
                  alt={image.alt}
                  data-en-alt={image.alt}
                  data-de-alt={image.translations?.de?.alt ?? image.alt}
                  class="w-full h-auto object-cover"
                  loading={index < 6 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              ) : (
                <Image
                  src={image.src}
                  alt={image.alt}
                  width="800"
                  height="800"
                  class="w-full h-auto object-cover"
                  loading={index < 6 ? 'eager' : 'lazy'}
                  fetchpriority={index < 2 ? 'high' : undefined}
                  decoding="async"
                />
              )
            }
            {/* Always-visible caption for touch + keyboard; hover only deepens the scrim */}
            <div
              class="gallery-caption pointer-events-none absolute inset-x-0 bottom-0 px-3 pb-3 pt-10"
            >
              <h3
                class="text-sm font-medium text-stone-50 md:text-base"
                data-en={image.title}
                data-de={image.translations?.de?.title ?? image.title}
              >
                {image.title}
              </h3>
              <p
                class="mt-0.5 text-xs font-light tracking-wide text-stone-200/90 md:text-sm"
                data-en={formatMainCategoryAndTags(image)}
                data-de={germanMainCategoryAndTags(image)}
              >
                {formatMainCategoryAndTags(image)}
              </p>
            </div>
          </div>
        </a>
      </div>
    ))
  }
</div>

<style>
  .gallery-caption {
    background: linear-gradient(
      to top,
      var(--color-overlay, oklch(8% 0.03 285 / 0.55)) 0%,
      transparent 100%
    );
  }
</style>

<script>
  function shuffleGalleries() {
    document.querySelectorAll<HTMLElement>('[data-randomize="true"]').forEach((gallery) => {
      const items = Array.from(gallery.children);
      for (let index = items.length - 1; index > 0; index -= 1) {
        const swapIndex = Math.floor(Math.random() * (index + 1));
        [items[index], items[swapIndex]] = [items[swapIndex], items[index]];
      }
      items.forEach((item) => gallery.append(item));
    });
  }

  shuffleGalleries();
  document.addEventListener('astro:page-load', shuffleGalleries);
</script>
