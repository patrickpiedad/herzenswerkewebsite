---
import { ClientRouter } from 'astro:transitions';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';
import path from 'path';

interface Props {
  title: string;
  titleDe?: string;
}

const { title, titleDe = title } = Astro.props;
const { BASE_URL } = import.meta.env;
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title data-en={title} data-de={titleDe}>{title}</title>
    <link
      rel="icon"
      type="image/svg+xml"
      href={path.join(BASE_URL, 'favicon.svg')}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Dark-first theme init — respect stored preference, else default dark
      (function () {
        const root = document.documentElement;
        const stored =
          typeof localStorage !== 'undefined'
            ? localStorage.getItem('theme')
            : null;
        const theme = stored === 'light' || stored === 'dark' ? stored : 'dark';

        root.classList.toggle('dark', theme === 'dark');
        root.classList.toggle('light', theme === 'light');
        root.style.colorScheme = theme;
        if (typeof localStorage !== 'undefined') {
          localStorage.setItem('theme', theme);
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body
    class="min-h-screen flex flex-col bg-paper font-sans text-ink antialiased transition-colors duration-300"
    transition:animate="initial"
  >
    <div class="fixed top-6 right-6 z-20">
      <div class="flex items-center gap-2">
        <button
          id="language-toggle"
          type="button"
          data-en="DE"
          data-de="EN"
          aria-label="Switch language to German"
          data-en-label="Switch language to German"
          data-de-label="Switch language to English"
          class="inline-flex h-10 min-w-10 items-center justify-center rounded-full bg-paper-2 px-3 text-xs font-medium tracking-wide text-ink transition-colors duration-200 hover:opacity-90"
        >
          DE
        </button>
        <ThemeToggle />
      </div>
    </div>

    <header class="border-b border-rule bg-paper">
      <nav
        class="container mx-auto flex flex-wrap items-center justify-between gap-x-8 gap-y-3 px-6 py-5 pr-24 sm:pr-28"
        aria-label="Main navigation"
        data-en-label="Main navigation"
        data-de-label="Hauptnavigation"
      >
        <a
          href={BASE_URL}
          class="font-display text-2xl tracking-wide text-ink transition-colors hover:text-accent"
        >
          Herzens Werke
        </a>
        <div class="flex items-center gap-6 text-sm font-light tracking-wide">
          <a
            href={BASE_URL}
            class:list={[
              'transition-colors hover:text-accent',
              { 'text-accent': currentPath === '/', 'text-muted': currentPath !== '/' },
            ]}
            aria-current={currentPath === '/' ? 'page' : undefined}
          >
            <span data-en="Home" data-de="Startseite">Home</span>
          </a>
          <a
            href={path.join(BASE_URL, 'about')}
            class:list={[
              'transition-colors hover:text-accent',
              { 'text-accent': currentPath === '/about', 'text-muted': currentPath !== '/about' },
            ]}
            aria-current={currentPath === '/about' ? 'page' : undefined}
          >
            <span data-en="About" data-de="Über mich">About</span>
          </a>
          <a
            href={path.join(BASE_URL, 'contact')}
            class:list={[
              'transition-colors hover:text-accent',
              { 'text-accent': currentPath === '/contact', 'text-muted': currentPath !== '/contact' },
            ]}
            aria-current={currentPath === '/contact' ? 'page' : undefined}
          >
            <span data-en="Contact" data-de="Kontakt">Contact</span>
          </a>
        </div>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer
      class="mt-16 bg-paper-2 py-8"
      transition:name="footer"
    >
      <div
        class="container mx-auto px-6 text-center text-sm font-light text-muted"
      >
        <p>
          &copy; {new Date().getFullYear()}{' '}
          <span data-en="Herzens Werke" data-de="Herzens Werke">Herzens Werke</span>
        </p>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const getLanguage = () =>
          localStorage.getItem('language') === 'de' ? 'de' : 'en';

        const applyLanguage = (language) => {
          document.documentElement.lang = language;
          document.querySelectorAll('[data-en][data-de]').forEach((element) => {
            element.textContent = element.getAttribute(`data-${language}`);
          });
          document.querySelectorAll('[data-en-alt][data-de-alt]').forEach((element) => {
            element.setAttribute('alt', element.getAttribute(`data-${language}-alt`));
          });
          document.querySelectorAll('[data-en-placeholder][data-de-placeholder]').forEach((element) => {
            element.setAttribute('placeholder', element.getAttribute(`data-${language}-placeholder`));
          });
          document.querySelectorAll('[data-en-label][data-de-label]').forEach((element) => {
            element.setAttribute('aria-label', element.getAttribute(`data-${language}-label`));
          });
        };

        document.addEventListener('click', (event) => {
          if (event.target instanceof Element && event.target.closest('#language-toggle')) {
            const language = getLanguage() === 'en' ? 'de' : 'en';
            localStorage.setItem('language', language);
            applyLanguage(language);
          }
        });

        document.addEventListener('astro:page-load', () => applyLanguage(getLanguage()));
        document.addEventListener('DOMContentLoaded', () => applyLanguage(getLanguage()));
      })();
    </script>
  </body>
</html>
