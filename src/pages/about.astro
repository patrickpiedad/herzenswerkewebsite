---
import Layout from '../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

const { BASE_URL } = import.meta.env;
const portraitSrc = '/about/portrait.jpg';
const hasPortrait = fs.existsSync(
  path.join(process.cwd(), 'public', portraitSrc.slice(1)),
);
---

<Layout title="About — Herzens Werke" titleDe="Über mich — Herzens Werke">
  <div class="container mx-auto max-w-5xl px-6 py-20 sm:py-28">
    <div class="grid items-center gap-12 lg:grid-cols-[1.2fr_0.8fr] lg:gap-16">
      <div class="text-center">
        <p class="mb-5 text-sm font-light uppercase tracking-[0.2em] text-accent">
          <span data-en="A little about me" data-de="Ein wenig über mich">A little about me</span>
        </p>
        <h1 class="font-display mx-auto max-w-3xl text-5xl leading-tight font-normal tracking-wide text-ink sm:text-7xl">
          <span data-en="Making things by hand, and sharing a little joy" data-de="Mit Liebe gestalten und Freude teilen">Making things by hand, and sharing a little joy</span>
        </h1>
        <p class="mx-auto mt-8 max-w-2xl text-left text-lg leading-8 font-light text-muted">
          <span
            data-en="I have always enjoyed making things by hand. Whether it’s a card for a special occasion, a decoration for the home, or a new idea I’m excited to try, creating lets me turn simple materials into something personal. Herzens Werke is where I can share some of what I make and the joy I find in making it."
            data-de="Ich gestalte schon immer gern Dinge mit den eigenen Händen. Ob eine Karte für einen besonderen Anlass, eine Deko für Zuhause oder eine neue Idee, die ich ausprobieren möchte. Beim Kreativsein entstehen aus einfachen Materialien ganz persönliche Stücke. Bei Herzens Werke teile ich meine Arbeiten und die Freude am Gestalten."
          >I have always enjoyed making things by hand. Whether it’s a card for a
          special occasion, a decoration for the home, or a new idea I’m excited to
          try, creating lets me turn simple materials into something personal.
          Herzens Werke is where I can share some of what I make and the joy I find
          in making it.</span>
        </p>
        <p class="mx-auto mt-5 max-w-2xl text-left text-lg leading-8 font-light text-muted">
          <span
            data-en="Every piece starts with care and a bit of imagination. I hope you find something here that inspires you. If you have an idea of your own, I’d love to hear about it."
            data-de="Jedes Stück entsteht mit viel Sorgfalt und einer Prise Fantasie. Ich hoffe, du findest hier etwas, das dich inspiriert. Wenn du selbst eine Idee hast, freue ich mich, davon zu hören."
          >Every piece starts with care and a bit of imagination. I hope you find
          something here that inspires you. If you have an idea of your own,
          I’d love to hear about it.</span>
        </p>
      </div>

      <figure class="mx-auto w-full max-w-sm lg:translate-y-12">
        {
          hasPortrait ? (
            <img
              src={portraitSrc}
              alt="Portrait of the maker of Herzens Werke"
              data-en-alt="Portrait of the maker of Herzens Werke"
              data-de-alt="Porträt der Person hinter Herzens Werke"
              class="aspect-[4/5] w-full rounded-xl border border-rule object-cover shadow-xl"
              fetchpriority="high"
            />
          ) : (
            <div class="flex aspect-[4/5] w-full flex-col items-center justify-center rounded-xl border border-rule bg-paper-2 px-8 text-center shadow-xl">
              <span class="font-display text-5xl text-accent" aria-hidden="true">
                H
              </span>
              <p class="mt-5 text-lg text-ink" data-en="A portrait goes here" data-de="Hier kommt ein Porträt hin">A portrait goes here</p>
              <p class="mt-2 text-sm leading-6 font-light text-muted">
                <span data-en="Add your photo as" data-de="Füge dein Foto hier ein:">Add your photo as</span>
                {' '}<code class="text-accent">public/about/portrait.jpg</code>
              </p>
            </div>
          )
        }
        {hasPortrait && (
          <figcaption class="mt-3 text-center text-sm font-light text-muted">
          </figcaption>
        )}
      </figure>
    </div>

    <section class="mt-20 border-t border-rule pt-10 sm:mt-28" aria-labelledby="approach-heading">
      <p class="mb-4 text-center text-sm font-light uppercase tracking-[0.2em] text-accent">
        <span data-en="Made with care" data-de="Mit viel Liebe gemacht">Made with care</span>
      </p>
      <h2
        id="approach-heading"
        class="font-shadows mx-auto max-w-2xl text-center text-4xl leading-tight font-normal text-ink sm:text-5xl"
      >
        <span data-en="A handmade touch makes the little things feel special" data-de="Mit Handgemachtem bekommen auch die kleinen Dinge eine besondere Note">A handmade touch makes the little things feel special</span>
      </h2>
      <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        <article class="border-t border-rule pt-5">
          <p class="font-display text-3xl text-accent">01</p>
          <h3 class="mt-4 font-shadows text-lg text-ink" data-en="Cards" data-de="Karten">Cards</h3>
          <p class="mt-2 text-sm leading-6 font-light text-muted">
            <span data-en="Thoughtful, handmade cards for celebrations, milestones, and everyday moments." data-de="Liebevoll gestaltete Karten für besondere Anlässe und kleine Grüße im Alltag.">Thoughtful, handmade cards for celebrations, milestones, and everyday moments.</span>
          </p>
        </article>
        <article class="border-t border-rule pt-5">
          <p class="font-display text-3xl text-accent">02</p>
          <h3 class="mt-4 font-shadows text-lg text-ink" data-en="Decorations" data-de="Dekoration">Decorations</h3>
          <p class="mt-2 text-sm leading-6 font-light text-muted">
            <span data-en="Handmade details to bring a little warmth and personality to a space or occasion." data-de="Handgemachte Deko, die Zuhause und besonderen Anlässen eine persönliche Note verleiht.">Handmade details to bring a little warmth and personality to a space or occasion.</span>
          </p>
        </article>
        <article class="border-t border-rule pt-5">
          <p class="font-display text-3xl text-accent">03</p>
          <h3 class="mt-4 font-shadows text-lg text-ink" data-en="Jewelry" data-de="Schmuck">Jewelry</h3>
          <p class="mt-2 text-sm leading-6 font-light text-muted">
            <span data-en="Handmade jewelry and wearable pieces, each with a personal touch." data-de="Handgemachter Schmuck und Accessoires, alle mit persönlicher Note.">Handmade jewelry and wearable pieces, each with a personal touch.</span>
          </p>
        </article>
        <article class="border-t border-rule pt-5">
          <p class="font-display text-3xl text-accent">04</p>
          <h3 class="mt-4 font-shadows text-lg text-ink" data-en="Your ideas" data-de="Deine Ideen">Your ideas</h3>
          <p class="mt-2 text-sm leading-6 font-light text-muted">
            <span data-en="Have something in mind? I’m always happy to hear your ideas and explore what might work." data-de="Hast du schon eine Idee? Erzähl mir davon. Gemeinsam finden wir heraus, was sich umsetzen lässt.">Have something in mind? I’m always happy to hear your ideas and explore what might work.</span>
          </p>
        </article>
      </div>
    </section>

    <a
      href={BASE_URL}
      class="mt-14 inline-flex items-center gap-2 text-sm tracking-wide text-accent transition-colors hover:text-ink"
    >
      <span data-en="See what I make" data-de="Meine Arbeiten ansehen">See what I make</span> <span aria-hidden="true">→</span>
    </a>
  </div>
</Layout>
