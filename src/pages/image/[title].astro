---
// src/pages/image/[title].astro
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import path from 'path';
import { tagsOf, formatMainCategoryAndTags } from '../../utils/tags';

export async function getStaticPaths() {
  const RELATED_LIMIT = 8;
  const collection = await getCollection('gallery');
  const images = collection.map((a) => ({ ...a.data, id: a.id }));

  return images.map((image) => {
    const imageTags = tagsOf(image);
    const related = images
      .filter((img) => img.id !== image.id)
      .map((img) => {
        const otherTags = new Set(tagsOf(img));
        const score =
          Number(img.mainCategory === image.mainCategory) +
          imageTags.filter((tag) => otherTags.has(tag)).length;
        return { img, score };
      })
      .filter(({ score }) => score > 0)
      .sort((a, b) => {
        if (b.score !== a.score) return b.score - a.score;
        return a.img.title.localeCompare(b.img.title);
      })
      .slice(0, RELATED_LIMIT)
      .map(({ img }) => img);

    return {
      params: { title: image.id },
      props: { image, related },
    };
  });
}

const { image, related } = Astro.props;
const { BASE_URL } = import.meta.env;
const categoryLabel = formatMainCategoryAndTags(image);
const isVideo = image.mediaType === 'video';
const isLocalAsset = image.src.startsWith('/');

const largeSrc = isLocalAsset
  ? image.src
  : (() => {
      const url = new URL(image.src, 'https://images.unsplash.com');
      url.searchParams.set('w', '2400');
      url.searchParams.set('q', '80');
      url.searchParams.set('fit', 'max');
      url.searchParams.delete('h');
      url.searchParams.delete('crop');
      return url.toString();
    })();
---

<Layout title={`${image.title} — Herzens Werke`}>
  <div class="container mx-auto px-6 py-16">
    <a
      href={BASE_URL}
      class="mb-12 inline-flex items-center font-light text-muted transition-colors duration-300 hover:text-accent"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-5 w-5 mr-1"
        viewBox="0 0 20 20"
        fill="currentColor"
      >
        <path
          fill-rule="evenodd"
          d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z"
          clip-rule="evenodd"></path>
      </svg>
      Back to Home
    </a>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 items-start">
      <div
        class="lg:col-span-2 overflow-hidden rounded-lg max-h-[85vh] flex items-center justify-center bg-transparent"
        transition:name={`image-${image.id}`}
      >
        {
          isVideo ? (
            <video
              class="h-auto max-h-[85vh] max-w-full"
              controls
              playsinline
              preload="metadata"
              poster={image.poster}
            >
              <source src={image.src} />
              Your browser does not support video playback.
            </video>
          ) : (
            <button
              type="button"
              class="zoom-trigger"
              popovertarget="image-zoom"
              aria-label={`View larger: ${image.title}`}
            >
              {isLocalAsset ? (
                <img
                  src={image.src}
                  alt={image.alt}
                  class="h-auto max-h-[85vh] max-w-full object-contain"
                  loading="eager"
                />
              ) : (
                <Image
                  src={image.src}
                  alt={image.alt}
                  width="800"
                  height="800"
                  class="w-auto h-auto object-contain max-h-[85vh] max-w-full"
                  loading="eager"
                />
              )}
            </button>
          )
        }
      </div>

      <div class="lg:col-span-1 py-4 lg:sticky lg:top-8">
        <h1
          class="text-3xl font-light tracking-wide mb-2 text-ink"
        >
          {image.title}
        </h1>

        <h2
          class="text-lg font-light mb-8 text-muted tracking-wide"
        >
          {categoryLabel}
        </h2>

        <div class="mb-8">
          <p
            class="text-ink leading-relaxed font-light"
          >
            {image.description}
          </p>
        </div>

        <div class="space-y-4 text-sm">
          <div class="flex">
            <span class="font-medium w-28 text-muted">Type:</span>
            <span class="text-ink/80 font-light"
              >{image.mainCategory}</span
            >
          </div>
          {tagsOf(image).length > 0 && (
            <div class="flex">
              <span class="font-medium w-28 text-muted">Tags:</span>
              <span class="text-ink/80 font-light">{tagsOf(image).join(' · ')}</span>
            </div>
          )}

          <div class="flex">
            <span class="font-medium w-28 text-muted"
              >Date:</span
            >
            <span class="text-ink/80 font-light"
              >{
                new Date(image.date).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })
              }</span
            >
          </div>

          {image.photographer && (
            <div class="flex">
              <span class="font-medium w-28 text-muted">Photo by:</span>
              {image.photographerLink ? (
                <a
                  href={image.photographerLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-ink/80 hover:text-ink transition-colors duration-300 font-light"
                >
                  {image.photographer}
                </a>
              ) : (
                <span class="text-ink/80 font-light">{image.photographer}</span>
              )}
            </div>
          )}
        </div>
      </div>
    </div>

    {
      related.length > 0 && (
        <div class="mt-16">
          <h2 class="text-2xl font-light tracking-wide mb-8 text-ink">
            Related Images
          </h2>
          <div class="masonry-container columns-1 sm:columns-2 md:columns-3 lg:columns-4 gap-6 space-y-6">
            {related.map((image, i) => (
              <div class="masonry-item break-inside-avoid mb-6">
                <a
                  href={path.join(BASE_URL, 'image', image.id)}
                  class="group block overflow-hidden rounded-sm transition-all duration-300 relative"
                  transition:name={`image-${image.id}`}
                >
                  <div class="overflow-hidden relative">
                    {image.mediaType === 'video' ? (
                      <div class="relative">
                        <img
                          src={image.poster}
                          alt={image.alt}
                          loading={i < 5 ? 'eager' : 'lazy'}
                          class="w-full h-auto object-cover transition-transform duration-500 group-hover:scale-102"
                        />
                        <span
                          class="absolute inset-0 flex items-center justify-center text-white"
                          aria-hidden="true"
                        >
                          ▶
                        </span>
                      </div>
                    ) : image.src.startsWith('/') ? (
                      <img
                        src={image.src}
                        alt={image.alt}
                        loading={i < 5 ? 'eager' : 'lazy'}
                        class="w-full h-auto object-cover transition-transform duration-500 group-hover:scale-102"
                      />
                    ) : (
                      <Image
                        src={image.src}
                        alt={image.alt}
                        loading={i < 5 ? 'eager' : 'lazy'}
                        width="800"
                        height="800"
                        class="w-full h-auto object-cover transition-transform duration-500 group-hover:scale-102"
                      />
                    )}
                    <div class="absolute inset-0 bg-black opacity-0 group-hover:opacity-40 transition-opacity duration-300 flex items-center justify-center pointer-events-none">
                      <div class="text-white text-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 p-4">
                        <h3 class="text-lg font-medium mb-1">{image.title}</h3>
                        <p class="text-sm font-light tracking-wide opacity-90">
                          {formatMainCategoryAndTags(image)}
                        </p>
                      </div>
                    </div>
                  </div>
                </a>
              </div>
            ))}
          </div>
        </div>
      )
    }
  </div>
</Layout>

{
  !isVideo && (
    <div id="image-zoom" popover class="zoom-popover">
      <button
        type="button"
        class="zoom-backdrop"
        popovertarget="image-zoom"
        popovertargetaction="hide"
        aria-label="Close larger image"
      >
        <img src={largeSrc} alt={image.alt} />
      </button>
    </div>
  )
}

<style>
  .zoom-trigger {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
    max-width: 100%;
  }

  .zoom-popover {
    box-sizing: border-box;
    inset: 0;
    width: auto;
    height: auto;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden;
    background: rgba(12, 10, 9, 0.94);
    opacity: 0;
    transform: scale(0.98);
    transition:
      opacity 280ms ease,
      transform 280ms ease,
      overlay 280ms allow-discrete,
      display 280ms allow-discrete;
  }

  .zoom-popover:popover-open {
    opacity: 1;
    transform: scale(1);
  }

  @starting-style {
    .zoom-popover:popover-open {
      opacity: 0;
      transform: scale(0.98);
    }
  }

  .zoom-popover::backdrop {
    background: rgb(12 10 9 / 0);
    transition:
      background 280ms ease,
      overlay 280ms allow-discrete,
      display 280ms allow-discrete;
  }

  .zoom-popover:popover-open::backdrop {
    background: rgb(12 10 9 / 0.72);
  }

  @starting-style {
    .zoom-popover:popover-open::backdrop {
      background: rgb(12 10 9 / 0);
    }
  }

  .zoom-backdrop {
    box-sizing: border-box;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: clamp(1rem, 4vw, 2.5rem);
    border: 0;
    background: transparent;
    cursor: zoom-out;
  }

  .zoom-backdrop img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: calc(100dvh - 2 * clamp(1rem, 4vw, 2.5rem));
    object-fit: contain;
  }
</style>
