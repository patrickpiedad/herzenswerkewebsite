---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import CategoryFilters from '../components/CategoryFilters.astro';
import GalleryMasonry from '../components/GalleryMasonry.astro';
import { categoriesOf } from '../utils/categories';

const collection = await getCollection('gallery');
const images = collection.map((a) => ({ ...a.data, id: a.id }));
const allCategories = [
  ...new Set(images.flatMap((img) => categoriesOf(img))),
].sort((a, b) => a.localeCompare(b));
---

<Layout title="Home — Herzens Werke">
  <div class="container mx-auto px-6 py-16">
    <h1
      class="font-display text-5xl font-normal tracking-wide text-ink sm:text-6xl"
    >
      Handmade with heart.
    </h1>
    <p class="mb-10 mt-4 max-w-2xl text-lg leading-8 font-light text-muted">
      A collection of handmade cards, decorations, and little creative ideas. Browse for inspiration, and get in touch if you have something special in
      mind.
    </p>
    <CategoryFilters categories={allCategories} active="all" />
    <GalleryMasonry images={images} />
  </div>
</Layout>
